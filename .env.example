# API keys
ANTHROPIC_API_KEY=
HF_TOKEN=

# Qdrant (defaults to local Docker at http://localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Langfuse (cloud-based)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Redis (Optional; if empty, caching off)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600 # 1 hour
